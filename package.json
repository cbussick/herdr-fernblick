{
  "name": "herdr-fernblick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "build:storybook": "storybook build",
    "storybook": "storybook dev -p 6006",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . && stylelint \"src/**/*.css\"",
    "preview": "vite preview",
    "start": "node dist-server/server/index.js",
    "test": "vitest run --exclude \"dist-server/**\"",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.81.0",
    "storybook": "^10.5.10",
    "storybook-addon-pseudo-states": "^10.5.10",
    "stylelint": "^17.5.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.0"
  }
}
