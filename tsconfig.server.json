{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "src/shared/api/contracts.ts", "packages/pi-live-chat/**/*.ts"],
  "exclude": ["server/**/*.test.ts", "packages/**/*.test.ts"]
}
