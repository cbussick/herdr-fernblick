# Review every value against the running backend before cutover.
# systemd EnvironmentFile syntax: absolute literal values, no $HOME, ~ or shell commands.
# Install a reviewed private copy at /etc/fernblick/fernblick.env (root-owned 0600).
# Keep the service user identical to the current Herdr/Pi Unix user.
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
HERDR_SOCKET_PATH=/home/REPLACE/.config/herdr/herdr.sock
FERNBLICK_PI_SOCKET=/home/REPLACE/.local/share/fernblick/live/pi.sock
FERNBLICK_BOARD_DIR=/home/REPLACE/.local/share/fernblick/boards
FERNBLICK_READ_RECEIPT_DIR=/home/REPLACE/.local/share/fernblick/read-receipts
FERNBLICK_UPLOAD_DIR=/tmp/fernblick
# Application diagnostic files once HER-20 is integrated; harmless to older builds.
FERNBLICK_LOG_DIR=/home/REPLACE/.local/state/fernblick/logs
# If the current deployment sets these, preserve them explicitly too:
# FERNBLICK_RENDER_ORIGIN=http://127.0.0.1:8787
# FERNBLICK_PUBLIC_URL=https://your-existing-private-host/
# FERNBLICK_PI_GLOBAL=1
# FERNBLICK_PI_SESSION_DIR=/absolute/path/to/current/pi/sessions
# FERNBLICK_PI_ISOLATED=1
# FERNBLICK_HERDR_EXTENSION=/absolute/path/to/herdr-agent-state.ts
# PATH=/absolute/node/bin:/absolute/pi/bin:/usr/local/bin:/usr/bin:/bin
# Other required Pi/provider configuration belongs in this private local file,
# never in the generated unit or committed examples.
